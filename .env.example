# Optional: where `npm run dev` proxies /api. Defaults to a locally running
# fc-coach-api on http://localhost:3001.
VITE_API_PROXY_TARGET=

# Supabase public (publishable) credentials — safe for the browser. Not used
# by the placeholder page yet; they are already set on Vercel for when login
# is added. Dashboard > Project Settings > API Keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
